#!/usr/bin/env bash
#
# bin/compile BUILD_DIR CACHE_DIR
# BUILD_DIR - gives you a handle for the root directory of the app
# CACHE_DIR - gives you a location to persist build artifacts between deployments
# See more in https://blog.heroku.com/hacking-buildpacks
#
build="$1"
cache="$2"

# Stops the execution of the script if a command has an error 
set -e

# Create a directory for the virus database
mkdir -p "${cache}/clamav-data"

# Create a directory for the CVD certificates
mkdir -p "${cache}/clamav-certs"

# Download certificate
curl -fsSL https://raw.githubusercontent.com/Cisco-Talos/clamav/clamav-1.5.3/certs/clamav.crt -o "${cache}/clamav-certs/clamav.crt"

cp "${build}/config/clamav/freshclam.conf" "${cache}/freshclam.conf"
sed -i '/^DatabaseDirectory /d;/^CVDCertsDirectory /d' "${cache}/freshclam.conf"

printf '\n' >> "${cache}/freshclam.conf"

cat >> "${cache}/freshclam.conf" <<EOF
DatabaseDirectory ${cache}/clamav-data
CVDCertsDirectory ${cache}/clamav-certs
EOF

export CVD_CERTS_DIR="${cache}/clamav-certs"

# Refresh the virus database, the source is specified in the conf file
freshclam --config-file="${cache}/freshclam.conf" --quiet

# Replace the old virus database
rm -rf "${build}/.clamav-data"
cp -rp "${cache}/clamav-data" "${build}/.clamav-data"

# Replace the old CVD certificates
rm -rf "${build}/.clamav-certs"
cp -rp "${cache}/clamav-certs" "${build}/.clamav-certs"
